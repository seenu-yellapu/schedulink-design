{
  "permissions": {
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(gh pr review --approve:*)",
      "Bash(gh pr review -a:*)",
      "Bash(gh pr review * --approve*)",
      "Bash(gh pr review * -a*)",
      "Bash(gh api *pulls/*/merge*)",
      "Bash(gh api *pulls/*/reviews*)",
      "Bash(gh api graphql*mergePullRequest*)",
      "Bash(gh api graphql*addPullRequestReview*)",
      "Bash(gh api graphql*enablePullRequestAutoMerge*)",
      "Bash(git push*main*)",
      "Bash(git tag*)"
    ]
  }
}
